{
  "format": "custom",
  "id": "post",
  "label": "Archivo",
  "repeatable": true,
  "status": true,
  "json": {
    "Main": {
      "uid": {
        "type": "UID",
        "config": {
          "label": "UID"
        }
      },
      "hero": {
        "type": "Image",
        "config": {
          "label": "Portada",
          "constraint": {
            "width": 1920,
            "height": 1080
          },
          "thumbnails": []
        }
      },
      "title": {
        "type": "Text",
        "config": {
          "label": "Titulo (H1)",
          "placeholder": ""
        }
      },
      "article_type": {
        "type": "Select",
        "config": {
          "label": "Tipo de publicación",
          "options": ["Conversación", "Ensayo"],
          "default_value": "Ensayo"
        }
      },
      "introduction": {
        "type": "StructuredText",
        "config": {
          "label": "Introducción (opcional)",
          "placeholder": "Una breve presentación antes del video y del cuerpo del artículo.",
          "allowTargetBlank": true,
          "multi": "paragraph,strong,em,hyperlink"
        }
      },
      "video": {
        "type": "Embed",
        "config": {
          "label": "Video (opcional)",
          "placeholder": "Enlace de YouTube o Vimeo"
        }
      },
      "seo_title": {
        "type": "Text",
        "config": {
          "label": "Título SEO",
          "placeholder": ""
        }
      },
      "meta_description": {
        "type": "Text",
        "config": {
          "label": "Descripción SEO",
          "placeholder": ""
        }
      },
      "date": {
        "type": "Date",
        "config": {
          "label": "Fecha de publicación",
          "placeholder": ""
        }
      },
      "author": {
        "type": "Text",
        "config": {
          "label": "Autor (opcional)",
          "placeholder": ""
        }
      },
      "body": {
        "type": "StructuredText",
        "config": {
          "label": "Cuerpo de texto",
          "placeholder": "",
          "allowTargetBlank": true,
          "multi": "paragraph,heading2,heading3,strong,em,hyperlink,image,list-item,o-list-item"
        }
      }
    }
  }
}
